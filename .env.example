# Copy to .env.local and fill in. Never commit .env.local.

# ---- LiveKit (LiveKit Cloud dashboard > Settings > Keys) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- AI providers ----
# Gemini (realtime mode, and the LLM in pipeline mode)
GOOGLE_API_KEY=
# Only needed for VOICE_MODE=pipeline
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ---- Optional: MongoDB. Without it, records go to data/*.jsonl ----
MONGODB_URI=
MONGODB_DATABASE=

# ---- The business this agent answers for ----
# Change these per client or per demo; the agent sounds built for them.
# Industry template from knowledge/industries/:
#   home_services, dental, auto_repair, restaurant, salon_spa, law_firm
BUSINESS_TYPE=home_services
BUSINESS_NAME=Summit Home Services
BUSINESS_CITY=Houston, Texas
SERVICE_AREA=the greater Houston area
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_WEBSITE=
BUSINESS_HOURS=Monday to Friday 8 AM to 6 PM, Saturday 9 AM to 2 PM, closed Sunday
# IANA timezone: America/New_York, America/Chicago, America/Denver,
# America/Phoenix, America/Los_Angeles, America/Anchorage, Pacific/Honolulu
BUSINESS_TIMEZONE=America/Chicago

# ---- Voice ----
AGENT_NAME=Nova
# realtime = Gemini Live, dozens of languages with auto-detection (recommended)
# pipeline = Deepgram + Gemini + Cartesia, fewer languages
VOICE_MODE=realtime
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Gemini voice, e.g. Aoede, Kore (female) or Puck, Charon (male)
GEMINI_VOICE=Aoede
# Deepgram STT language (pipeline mode only): multi, or en, es...
STT_LANGUAGE=multi
# Mention in the greeting that callers can use their own language
ANNOUNCE_LANGUAGES=true
# Optional sentence said after the greeting, e.g. a recording notice
CALL_DISCLOSURE=

# ---- US SIP ----
# Your US number(s) in E.164 format, comma separated, e.g. +15125550198
SIP_PHONE_NUMBERS=
# Optional: your SIP provider's IPs/CIDRs (comma separated) and/or digest auth
SIP_ALLOWED_ADDRESSES=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
# Must match on both agent.py and setup_sip.py (they both read this)
AGENT_DISPATCH_NAME=front-desk

# Optional: owner's cell or front desk to transfer to, e.g. +15125550123
HUMAN_TRANSFER_NUMBER=

# Optional: POST every booking and message here (Zapier, Make, n8n, Slack webhook)
NOTIFY_WEBHOOK_URL=
